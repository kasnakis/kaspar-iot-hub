String line(){ String s; while(true){ while(Serial.available()){char c=Serial.read(); if(c=='\n'){s.trim();return s;} if(c!='\r' && s.length()<MAX_CERT_SIZE)s+=c;} delay(10); }}
String ask(const char* prompt){Serial.println(prompt);return line();}
String val(const char* k){return cfg[k].as<String>();}
void edit(const char* k,const char* label,bool secret=false){Serial.print(label); if(!secret){Serial.print(" [");Serial.print(val(k));Serial.print("]");} Serial.println(" (Enter=διατήρηση, -=διαγραφή)");String s=line();if(s=="-")cfg[k]="";else if(s.length())cfg[k]=s;}
void number(const char* k,const char* label,long lo,long hi){String s=ask(label);char* end;long n=strtol(s.c_str(),&end,10);if(s.length()&&!*end&&n>=lo&&n<=hi)cfg[k]=n;else Serial.println("Μη έγκυρη τιμή ή χωρίς αλλαγή");}
void defaults(){cfg.clear();cfg["ca_source"]="auto";cfg["ssid"]=DEFAULT_SSID;cfg["pass"]=DEFAULT_PASS;cfg["host"]=DEFAULT_HOST;cfg["port"]=DEFAULT_PORT;cfg["tls"]=DEFAULT_TLS;cfg["auth"]=DEFAULT_AUTH;cfg["user"]=DEFAULT_USER;cfg["password"]=DEFAULT_PASSWORD;cfg["id"]=baseId;cfg["device"]=baseId;cfg["static"]=DEFAULT_STATIC;cfg["ip"]=DEFAULT_IP;cfg["gw"]=DEFAULT_GW;cfg["mask"]=DEFAULT_MASK;cfg["dns"]=DEFAULT_DNS;cfg["dns2"]=DEFAULT_DNS2;cfg["topic"]=DEFAULT_TOPIC;cfg["status"]=DEFAULT_STATUS;cfg["sub"]=DEFAULT_SUB;cfg["online"]=DEFAULT_ONLINE;cfg["offline"]=DEFAULT_OFFLINE;cfg["interval"]=DEFAULT_INTERVAL;cfg["qos"]=DEFAULT_QOS;cfg["retain"]=DEFAULT_RETAIN;cfg["format"]=DEFAULT_FORMAT;cfg["template"]=DEFAULT_TEMPLATE;cfg["ntp"]=DEFAULT_NTP;cfg["ntp2"]=DEFAULT_NTP2;cfg["keepalive"]=DEFAULT_KEEPALIVE;cfg["retry"]=DEFAULT_RETRY;cfg["timeout"]=DEFAULT_TIMEOUT;JsonArray a=cfg["sensors"].to<JsonArray>();for(int i=0;i<2;i++){JsonObject o=a.add<JsonObject>();o["name"]=i?"humidity":"temperature";o["min"]=i?30:15;o["max"]=i?80:35;o["dec"]=1;o["mode"]=0;o["unit"]=i?"%":"C";o["enabled"]=true;}}
String readFile(const char* p){if(!fsOK)return "";File f=LittleFS.open(p,"r");if(!f||f.size()>MAX_CERT_SIZE)return "";return f.readString();}
bool validPem(String s,int i){if(i<2){mbedtls_x509_crt c;mbedtls_x509_crt_init(&c);int r=mbedtls_x509_crt_parse(&c,(const unsigned char*)s.c_str(),s.length()+1);mbedtls_x509_crt_free(&c);return r==0;}return s.indexOf("-----BEGIN ")>=0 && s.indexOf("PRIVATE KEY-----")>=0 && s.indexOf("-----END ")>=0;}
void importPem(int i){Serial.println("Επικολλήστε το PEM (όχι τον κώδικα C). END σε ξεχωριστή γραμμή, CANCEL για ακύρωση.");String s;while(true){String l=line();if(l=="CANCEL")return;if(l=="END")break;if(s.length()+l.length()>MAX_CERT_SIZE){Serial.println("Υπέρβαση μεγέθους, ακύρωση");return;}s+=l+"\n";}if(!validPem(s,i)){Serial.println("Μη έγκυρο PEM, χωρίς αλλαγή");return;}pending[i]=s;changed[i]=true;if(i==0)cfg["ca_source"]="auto";Serial.println("Προσωρινή αλλαγή. Αποθηκεύστε για διατήρηση.");}
bool save(){if(!fsOK){for(bool c:changed)if(c)return false;}for(int i=0;i<3;i++)if(changed[i]){if(!pending[i].length()){if(LittleFS.exists(paths[i])&&!LittleFS.remove(paths[i]))return false;}else{String tmp=String(paths[i])+".tmp";File f=LittleFS.open(tmp,"w");if(!f)return false;size_t n=f.print(pending[i]);f.close();if(n!=pending[i].length()||!LittleFS.rename(tmp,paths[i]))return false;}}String s;serializeJson(cfg,s);return prefs.putString("config",s)>0;}
String expand(String s){s.replace("{device_id}",val("device"));s.replace("{device_key}",val("device"));return s;}
void preset(){String s=ask("1 KasPar / 2 ThingsBoard / 3 Γενικό προφίλ / 4 AWS IoT");if(s!="1"&&s!="2"&&s!="3"&&s!="4")return;cfg["host"]="";cfg["user"]="";cfg["password"]="";cfg["port"]=s=="1"?18883:8883;cfg["tls"]=s=="4"?3:2;cfg["auth"]=s=="1"?1:s=="2"?2:0;cfg["topic"]=s=="1"?"kaspar/v1/devices/{device_key}/telemetry":s=="2"?"v1/devices/me/telemetry":"devices/{device_id}/telemetry";cfg["status"]=s=="1"?"kaspar/v1/devices/{device_key}/status":"";cfg["format"]=s=="1"?1:0;cfg["qos"]=1;Serial.println("Το προφίλ εφαρμόστηκε. Ρυθμίστε broker, διαπιστευτήρια και CA.");}
void sensors(){JsonArray a=cfg["sensors"].as<JsonArray>();for(unsigned i=0;i<a.size();i++){Serial.printf("%u: %s\n",i+1,a[i]["name"].as<const char*>());}String cmd=ask("a Προσθήκη / m Τροποποίηση / d Διαγραφή / b Επιστροφή");if(cmd=="b")return;int i=-1;if(cmd=="a"){if(a.size()>=MAX_VIRTUAL_SENSORS)return;}else if(cmd=="m"||cmd=="d"){i=ask("Αριθμός αισθητήρα").toInt()-1;if(i<0||i>=int(a.size()))return;if(cmd=="d"){a.remove(i);return;}}else return;String name=ask("Κλειδί τηλεμετρίας");if(!name.length()||name=="seq"||name=="ts")return;for(unsigned j=0;j<a.size();j++)if(int(j)!=i&&a[j]["name"].as<String>()==name)return;String l=ask("Ελάχιστη τιμή"),h=ask("Μέγιστη τιμή");char *e1,*e2;double lo=strtod(l.c_str(),&e1),hi=strtod(h.c_str(),&e2);if(!l.length()||!h.length()||*e1||*e2||!isfinite(lo)||!isfinite(hi)||lo>hi)return;int d=ask("Δεκαδικά ψηφία 0-6").toInt(),m=ask("Λειτουργία: 0 τυχαία / 1 σταθερή (ελάχιστη) / 2 αυξανόμενη / 3 ημιτονοειδής").toInt();if(d<0||d>6||m<0||m>3)return;String u=ask("Μονάδα μέτρησης (μεταδεδομένα)");bool enabled=ask("Ενεργός; y=ναι / n=όχι")=="y";JsonObject o=i<0?a.add<JsonObject>():a[i].as<JsonObject>();o["name"]=name;o["min"]=lo;o["max"]=hi;o["dec"]=d;o["mode"]=m;o["unit"]=u;o["enabled"]=enabled;}
String payload(){JsonDocument d;JsonObject values;if(int(cfg["format"])==2){d["ts"]=(uint64_t)time(nullptr)*1000;values=d["values"].to<JsonObject>();}else values=d.to<JsonObject>();if(int(cfg["format"])==1){values["seq"]=++seq;prefs.putUInt("seq",seq);if(time(nullptr)>1700000000)values["ts"]=(uint64_t)time(nullptr)*1000;}for(JsonObject o:cfg["sensors"].as<JsonArray>()){if(!o["enabled"].as<bool>())continue;double lo=o["min"],hi=o["max"],x=0;switch(o["mode"].as<int>()){case 0:x=esp_random()/4294967295.0;break;case 2:x=(millis()/1000%100)/99.0;break;case 3:x=(1+sin(millis()/10000.0))/2;break;}double scale=pow(10,o["dec"].as<int>());values[o["name"].as<String>()]=round((lo+(hi-lo)*x)*scale)/scale;}String s;serializeJson(d,s);if(int(cfg["format"])==3){s=val("template");for(JsonPair kv:values){String v;serializeJson(kv.value(),v);s.replace("{"+String(kv.key().c_str())+"}",v);}s.replace("{device_id}",val("device"));}return s;}
void received(String &topic,String &data){Serial.printf("Λήψη (RX) %s: %s\n",topic.c_str(),data.c_str());}
bool connectNow(){if(!val("ssid").length()||!val("host").length())return false;if(WiFi.status()!=WL_CONNECTED){WiFi.mode(WIFI_STA);if(int(cfg["static"])){IPAddress ip,gw,mask,dns,dns2;if(!ip.fromString(val("ip"))||!gw.fromString(val("gw"))||!mask.fromString(val("mask"))||!dns.fromString(val("dns"))||!dns2.fromString(val("dns2")))return false;WiFi.config(ip,gw,mask,dns,dns2);}else WiFi.config(INADDR_NONE,INADDR_NONE,INADDR_NONE);WiFi.begin(val("ssid").c_str(),val("pass").c_str());uint32_t start=millis();while(WiFi.status()!=WL_CONNECTED&&millis()-start<15000)delay(100);}if(WiFi.status()!=WL_CONNECTED){Serial.println("Αποτυχία σύνδεσης Wi-Fi");return false;}Serial.print("IP: ");Serial.println(WiFi.localIP());IPAddress resolved;if(!WiFi.hostByName(val("host").c_str(),resolved)){Serial.println("Αποτυχία επίλυσης DNS");return false;}Serial.print("IP του broker: ");Serial.println(resolved);int tls=cfg["tls"];if(tls>=2){configTime(0,0,val("ntp").c_str(),val("ntp2").c_str());uint32_t start=millis();while(time(nullptr)<1700000000&&millis()-start<15000)delay(100);if(time(nullptr)<1700000000||!ca.length()){Serial.println("Το επαληθευμένο TLS απαιτεί έγκυρη ώρα και πιστοποιητικό CA");return false;}secure.setCACert(ca.c_str());if(tls==3){if(!cert.length()||!key.length())return false;secure.setCertificate(cert.c_str());secure.setPrivateKey(key.c_str());}}else if(tls==1){secure.setInsecure();Serial.println("ΠΡΟΣΟΧΗ: Δεν επαληθεύεται η ταυτότητα του broker μέσω TLS");}else Serial.println("ΠΡΟΣΟΧΗ: Μη κρυπτογραφημένη επικοινωνία MQTT");brokerHost=val("host");if(tls)mqtt.begin(brokerHost.c_str(),cfg["port"].as<int>(),secure);else mqtt.begin(brokerHost.c_str(),cfg["port"].as<int>(),plain);mqtt.setOptions(cfg["keepalive"].as<int>(),true,cfg["timeout"].as<int>()*1000);String st=expand(val("status"));if(st.length())mqtt.setWill(st.c_str(),val("offline").c_str(),true,1);String id=val("id"),u=val("user"),p=val("password");int auth=cfg["auth"];bool ok=auth==0?mqtt.connect(id.c_str()):mqtt.connect(id.c_str(),u.c_str(),auth==2?nullptr:p.c_str());Serial.printf("MQTT: %s | σφάλμα=%d | κωδικός επιστροφής=%d\n",ok?"συνδέθηκε":"απέτυχε",(int)mqtt.lastError(),(int)mqtt.returnCode());if(ok){if(st.length())mqtt.publish(st,val("online"),true,1);if(val("sub").length())mqtt.subscribe(expand(val("sub")),cfg["qos"].as<int>());}return ok;}
void publishTest(){if(!mqtt.connected()){Serial.println("Δεν υπάρχει σύνδεση MQTT");return;}String s=payload();bool ok=mqtt.publish(expand(val("topic")),s,cfg["retain"].as<int>()!=0,cfg["qos"].as<int>());Serial.printf("Αποστολή (TX) %s: %s\n",ok?"OK":"ΑΠΟΤΥΧΙΑ",s.c_str());}
void menu(){if(mqtt.connected()){if(val("status").length())mqtt.publish(expand(val("status")),val("offline"),true,1);mqtt.disconnect();}while(true){Serial.println("\n======= Ρυθμίσεις KasPar-IoT =======\n1 Ασύρματο δίκτυο Wi-Fi\n2 Ρυθμίσεις δικτύου\n3 Διακομιστής MQTT (broker)\n4 Αυθεντικοποίηση\n5 TLS / Πιστοποιητικά\n6 Θέματα MQTT (topics)\n7 Τηλεμετρία\n8 Εικονικοί αισθητήρες\n9 Προκαθορισμένα προφίλ\n10 Συσκευή\n11 Συγχρονισμός ώρας NTP\nt Οδηγίες δοκιμής σύνδεσης\np Οδηγίες δοκιμαστικής αποστολής\ni Πληροφορίες\ns Αποθήκευση και επανεκκίνηση\nr Επανεκκίνηση χωρίς αποθήκευση\ne Επαναφορά εργοστασιακών ρυθμίσεων\n====================================\nΕπιλογή:");String c=line();if(c=="1"){edit("ssid","SSID");edit("pass","Κωδικός Wi-Fi",true);}else if(c=="2"){number("static","0 DHCP / 1 Στατική IP",0,1);if(int(cfg["static"])){edit("ip","IP");edit("gw","Πύλη δικτύου");edit("mask","Μάσκα υποδικτύου");edit("dns","DNS1");edit("dns2","DNS2");}}else if(c=="3"){edit("host","Διεύθυνση broker (IP/FQDN)");number("port","Θύρα 1-65535",1,65535);number("keepalive","Διάστημα διατήρησης σύνδεσης (δευτ.)",5,600);number("retry","Διάστημα επανασύνδεσης (δευτ.)",1,600);number("timeout","Χρονικό όριο MQTT (δευτ.)",1,60);}else if(c=="4"){number("auth","0 Ανώνυμη / 1 Χρήστης και κωδικός / 2 Token ως όνομα χρήστη",0,2);edit("user","Όνομα χρήστη / token",true);edit("password","Κωδικός πρόσβασης",true);}else if(c=="5"){String t=ask("\n======= TLS / Πιστοποιητικά =======\n1 MQTT χωρίς TLS\n2 TLS χωρίς επαλήθευση\n3 TLS με επαλήθευση CA\n4 Αμοιβαίο TLS (mTLS)\n5 Εισαγωγή CA\n6 Εισαγωγή πιστοποιητικού πελάτη\n7 Εισαγωγή ιδιωτικού κλειδιού\n8 Πληροφορίες πιστοποιητικών\n9 Διαγραφή CA\n10 Διαγραφή πιστοποιητικού πελάτη και κλειδιού\n11 Αρχικοποίηση συστήματος αρχείων\n12 Επαναφορά ενσωματωμένου CA\nΕπιλογή:");if(t=="1"||t=="2"||t=="3"||t=="4"){if(t=="2"&&ask("Μη ασφαλής επιλογή. Πληκτρολογήστε YES για επιβεβαίωση")!="YES")continue;cfg["tls"]=t.toInt()-1;}else if(t=="5"||t=="6"||t=="7")importPem(t.toInt()-5);else if(t=="8"){Serial.printf("Επιλογή CA: %s | ενσωματωμένο: %u bytes\n",val("ca_source").c_str(),(unsigned)strlen(BUILTIN_CA_PEM));for(int j=0;j<3;j++)Serial.printf("%s: %u bytes\n",paths[j],(unsigned)(changed[j]?pending[j].length():readFile(paths[j]).length()));}else if(t=="12"){if(!strlen(BUILTIN_CA_PEM)||!validPem(String(BUILTIN_CA_PEM),0)){Serial.println("Δεν υπάρχει έγκυρο ενσωματωμένο CA");}else{cfg["ca_source"]="builtin";Serial.println("Επιλέχθηκε το ενσωματωμένο CA. Αποθηκεύστε για εφαρμογή.");}}else if(t=="11"){if(ask("Πληκτρολογήστε FORMAT για διαγραφή του συστήματος αρχείων") == "FORMAT"){LittleFS.end();fsOK=LittleFS.format() && LittleFS.begin(false);Serial.println(fsOK?"Το σύστημα αρχείων είναι έτοιμο":"Αποτυχία μορφοποίησης");}}else if(t=="9"||t=="10"){if(t=="9")cfg["ca_source"]="disabled";int j=t=="9"?0:1;for(;j<(t=="9"?1:3);j++){changed[j]=true;pending[j]="";}}}else if(c=="6"){edit("topic","Topic τηλεμετρίας");edit("status","Topic κατάστασης (κενό για απενεργοποίηση)");edit("sub","Topic εγγραφής (subscribe)");edit("online","Μήνυμα σύνδεσης (online)");edit("offline","Μήνυμα τελευταίας διαθήκης (Last Will)");number("retain","Διατήρηση τηλεμετρίας (retain) 0/1",0,1);}else if(c=="7"){number("interval","Διάστημα αποστολής (δευτ.)",1,86400);number("qos","QoS 0/1/2",0,2);number("format","0 Απλό JSON / 1 KasPar / 2 Τιμές με χρονική σήμανση / 3 Προσαρμοσμένο πρότυπο",0,3);if(int(cfg["format"])==3)edit("template","Πρότυπο με μεταβλητές {sensor_key}");}else if(c=="8")sensors();else if(c=="9")preset();else if(c=="10"){edit("device","Κλειδί συσκευής");edit("id","Αναγνωριστικό πελάτη MQTT");}else if(c=="11"){edit("ntp","NTP1");edit("ntp2","NTP2");}else if(c=="i"){Serial.printf("Firmware " FIRMWARE_VERSION " | ελεύθερη μνήμη %u | RSSI %d | χρόνος λειτουργίας %lu δευτ.\n",ESP.getFreeHeap(),WiFi.RSSI(),millis()/1000);JsonDocument visible;visible=cfg;for(const char* k:{"pass","user","password"}){visible[k]=val(k).length()?"[ρυθμισμένο]":"[κενό]";}// Ελληνική προβολή αντιγράφου των ρυθμίσεων, χωρίς αλλαγή των αποθηκευμένων κλειδιών.
const char* fields[][2]={{"ca_source","Πηγή CA"},{"ssid","SSID"},{"pass","Κωδικός Wi-Fi"},{"host","Broker"},{"port","Θύρα"},{"tls","Λειτουργία TLS"},{"auth","Αυθεντικοποίηση"},{"user","Χρήστης/token"},{"password","Κωδικός MQTT"},{"id","ID πελάτη"},{"device","Κλειδί συσκευής"},{"static","Στατική IP"},{"ip","IP"},{"gw","Πύλη"},{"mask","Μάσκα"},{"dns","DNS1"},{"dns2","DNS2"},{"topic","Topic τηλεμετρίας"},{"status","Topic κατάστασης"},{"sub","Topic εγγραφής"},{"online","Μήνυμα σύνδεσης"},{"offline","Μήνυμα Last Will"},{"interval","Διάστημα (δευτ.)"},{"qos","QoS"},{"retain","Retain"},{"format","Μορφή τηλεμετρίας"},{"template","Πρότυπο"},{"ntp","NTP1"},{"ntp2","NTP2"},{"keepalive","Keepalive (δευτ.)"},{"retry","Επανασύνδεση (δευτ.)"},{"timeout","Χρονικό όριο (δευτ.)"},{"sensors","Αισθητήρες"}};
for(auto &field:fields){if(visible.containsKey(field[0])){visible[field[1]].set(visible[field[0]]);visible.remove(field[0]);}}
serializeJsonPretty(visible,Serial);Serial.println();}else if(c=="s"){if(save())ESP.restart();else Serial.println("Αποτυχία αποθήκευσης");}else if(c=="r")ESP.restart();else if(c=="e"){if(ask("Πληκτρολογήστε ERASE για επαναφορά εργοστασιακών ρυθμίσεων") == "ERASE"){prefs.clear();if(fsOK)for(auto p:paths)LittleFS.remove(p);ESP.restart();}}else if(c=="t"||c=="p"){Serial.println("Αποθηκεύστε και επανεκκινήστε. Στη συνέχεια πληκτρολογήστε test ή publish κατά τη λειτουργία.");}}}
void setup(){Serial.begin(SERIAL_BAUD_RATE);delay(500);baseId="esp32-"+String((uint32_t)ESP.getEfuseMac(),HEX);prefs.begin(NVS_NAMESPACE,false);seq=prefs.getUInt("seq",0);fsOK=LittleFS.begin(false);if(!fsOK)Serial.println("Το LittleFS δεν είναι διαθέσιμο. Επιλέξτε διαμέρισμα με σύστημα αρχείων και αρχικοποιήστε εάν χρειάζεται.");defaults();String s=prefs.getString("config","");if(s.length()){JsonDocument loaded;if(!deserializeJson(loaded,s))cfg=loaded;}ca=readFile(paths[0]);String source=val("ca_source");if(source=="disabled")ca="";else if(source=="builtin"||!ca.length())ca=BUILTIN_CA_PEM;cert=readFile(paths[1]);key=readFile(paths[2]);mqtt.onMessage(received);Serial.println("Πληκτρολογήστε setup και Enter για το μενού ρυθμίσεων");if(!val("ssid").length()||!val("host").length())menu();}
void loop(){if(Serial.available()){String c=line();if(c=="setup")menu();else if(c=="test"){if(!mqtt.connected())connectNow();else Serial.println("Το MQTT είναι συνδεδεμένο");}else if(c=="publish")publishTest();}if(!mqtt.connected()){if(!lastTry||millis()-lastTry>=cfg["retry"].as<uint32_t>()*1000){lastTry=millis();connectNow();}}else{mqtt.loop();if(!lastPub||millis()-lastPub>=cfg["interval"].as<uint32_t>()*1000){lastPub=millis();publishTest();}}delay(10);}
