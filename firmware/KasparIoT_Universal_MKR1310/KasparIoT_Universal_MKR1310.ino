#include <MKRWAN.h>
#include "config.h"
#include "Storage.h"
#include "PayloadEncoder.h"
LoRaModem modem;
Config cfg;
bool ready=false,joined=false,menu=true,dirty=false;
uint32_t lastTx=0; bool sent=false;
String line;
void defaults(){ memset(&cfg,0,sizeof(cfg)); cfg.magic=MAGIC; cfg.interval=300; cfg.port=10; cfg.adr=1; strcpy(cfg.sensors[0].key,"temperature"); cfg.sensors[0].low=15; cfg.sensors[0].high=35; cfg.sensors[0].enabled=1; strcpy(cfg.sensors[1].key,"humidity"); cfg.sensors[1].low=30; cfg.sensors[1].high=80; cfg.sensors[1].enabled=1; }
void show(){ Serial.println(F("\n====== KasPar-IoT Universal LoRaWAN ======\n1  Πληροφορίες\n2  JoinEUI / AppKey (OTAA)\n3  Διάστημα / FPort / ADR / Confirmed\n4  Εικονικοί αισθητήρες\n5  Μορφή payload\nj  Σύνδεση (Join)\np  Δοκιμαστική αποστολή\ni  Ενεργές ρυθμίσεις\ns  Αποθήκευση και επανεκκίνηση\nr  Επανεκκίνηση χωρίς αποθήκευση\ne  Εργοστασιακές ρυθμίσεις\nx  Έξοδος από μενού\nh  Βοήθεια")); }
String ask(const __FlashStringHelper *p){ Serial.println(p); String s; while(true){ while(Serial.available()){char c=Serial.read(); if(c=='\n'){s.trim();return s;} if(c!='\r' && s.length()<100)s+=c;} delay(5); } }
bool hexOK(String s,unsigned n){if(s.length()!=n)return false; for(unsigned i=0;i<n;i++)if(!isxdigit(s[i]))return false;return true;}
bool number(String s,long lo,long hi,long &v){char *e;v=strtol(s.c_str(),&e,10);return s.length() && *e==0 && v>=lo && v<=hi;}
bool realValue(String s,float &v){char *e;v=strtof(s.c_str(),&e);return s.length() && *e==0 && isfinite(v) && fabs(v)<=1000000;}
void info(){Serial.print(F("DevEUI: "));if(ready)Serial.println(modem.deviceEUI());else Serial.println(F("Μη διαθέσιμο"));Serial.print(F("JoinEUI: "));Serial.println(cfg.eui);Serial.print(F("AppKey: "));Serial.println(cfg.key[0]?"********":"-");Serial.print(F("Διάστημα (s): "));Serial.println(cfg.interval);Serial.print(F("FPort: "));Serial.println(cfg.port);Serial.print(F("ADR: "));Serial.println(cfg.adr);Serial.print(F("Confirmed: "));Serial.println(cfg.confirmed);Serial.println(cfg.format?F("JSON"):F("Binary v1"));for(int i=0;i<MAX_SENSORS;i++){Serial.print(i+1);Serial.print(' ');Serial.print(cfg.sensors[i].key);Serial.print(' ');Serial.print(cfg.sensors[i].low);Serial.print(' ');Serial.print(cfg.sensors[i].high);Serial.print(' ');Serial.println(cfg.sensors[i].enabled);}}
void joinNet(){if(dirty){Serial.println(F("Αποθηκεύστε πρώτα με s."));return;}if(joined){Serial.println(F("Ήδη συνδεδεμένο."));return;}if(!ready||!hexOK(cfg.eui,16)||!hexOK(cfg.key,32)){Serial.println(F("Ελέγξτε modem και OTAA."));return;} static bool tried=false;static uint32_t last=0;if(tried && millis()-last<60000){Serial.println(F("Περιμένετε 60 s μεταξύ προσπαθειών."));return;}tried=true;last=millis();Serial.println(F("Προσπάθεια OTAA..."));joined=modem.joinOTAA(String(cfg.eui),String(cfg.key));if(joined){modem.setADR(cfg.adr);modem.minPollInterval(60);Serial.println(F("Join επιτυχές"));}else Serial.println(F("Join απέτυχε"));}
void publish(){if(!joined||dirty){Serial.println(F("Απαιτείται Join και αποθηκευμένες ρυθμίσεις."));return;}if(sent && millis()-lastTx<cfg.interval*1000UL){Serial.println(F("Αναμονή διαστήματος αποστολής."));return;}float v[MAX_SENSORS];for(int i=0;i<MAX_SENSORS;i++)v[i]=cfg.sensors[i].low+(cfg.sensors[i].high-cfg.sensors[i].low)*random(0,10001)/10000.0f;uint8_t b[42];size_t n;String json;if(cfg.format){json="{";for(int i=0;i<MAX_SENSORS;i++)if(cfg.sensors[i].enabled){if(json.length()>1)json+=",";json+='"';json+=cfg.sensors[i].key;json+=F("\":");json+=String(v[i],2);}json+='}';n=json.length();}else n=encodeBinary(cfg,v,b);if(n>51){Serial.println(F("Payload >51 bytes: μειώστε αισθητήρες ή χρησιμοποιήστε binary."));lastTx=millis();sent=true;return;}modem.setPort(cfg.port);modem.beginPacket();if(cfg.format)modem.write((const uint8_t*)json.c_str(),n);else modem.write(b,n);int result=modem.endPacket(cfg.confirmed);lastTx=millis();sent=true;Serial.print(F("Αποτέλεσμα modem: "));Serial.println(result);Serial.println(F("Ελέγξτε το uplink στον ChirpStack."));while(modem.available()){int x=modem.read();Serial.print(x,HEX);Serial.print(' ');}Serial.println();}
void command(String s){long x; if(s=="setup"||s=="h"||s=="help"||!s.length()){menu=true;show();return;}if(s=="i"||s=="1")info();else if(s=="j")joinNet();else if(s=="p")publish();else if(s=="x"){menu=false;Serial.println(F("Λειτουργία τηλεμετρίας. setup για μενού."));}else if(s=="2"){String a=ask(F("JoinEUI (16 HEX):")),b=ask(F("AppKey (32 HEX):"));if(hexOK(a,16)&&hexOK(b,32)){a.toCharArray(cfg.eui,17);b.toCharArray(cfg.key,33);dirty=true;}else Serial.println(F("Μη έγκυρα στοιχεία."));}else if(s=="3"){long a,b,c,d;if(number(ask(F("Διάστημα 300–86400 s:")),300,86400,a)&&number(ask(F("FPort 1–223:")),1,223,b)&&number(ask(F("ADR 0/1:")),0,1,c)&&number(ask(F("Confirmed 0/1:")),0,1,d)){cfg.interval=a;cfg.port=b;cfg.adr=c;cfg.confirmed=d;dirty=true;}else Serial.println(F("Μη έγκυρη τιμή."));}else if(s=="4"){if(!number(ask(F("Αριθμός αισθητήρα 1–8:")),1,8,x))return;Sensor t={};String k=ask(F("Κλειδί ASCII (γράμματα, αριθμοί, _):"));bool ok=k.length()>0&&k.length()<=16;for(unsigned i=0;i<k.length();i++)if(!isalnum(k[i])&&k[i]!='_')ok=false;long en;if(ok&&realValue(ask(F("Ελάχιστο:")),t.low)&&realValue(ask(F("Μέγιστο:")),t.high)&&t.low<=t.high&&number(ask(F("Ενεργός 0/1:")),0,1,en)){k.toCharArray(t.key,17);t.enabled=en;cfg.sensors[x-1]=t;dirty=true;}else Serial.println(F("Μη έγκυρη τιμή."));}else if(s=="5"){if(number(ask(F("0 Binary / 1 JSON:")),0,1,x)){cfg.format=x;dirty=true;}}else if(s=="s"){settingsStore.write(cfg);NVIC_SystemReset();}else if(s=="r")NVIC_SystemReset();else if(s=="e"){if(ask(F("Πληκτρολογήστε ERASE για διαγραφή ρυθμίσεων:"))=="ERASE"){defaults();settingsStore.write(cfg);NVIC_SystemReset();}}else Serial.println(F("Άγνωστη εντολή. h για βοήθεια."));if(menu)show();}
void setup(){Serial.begin(115200);uint32_t start=millis();while(!Serial&&millis()-start<5000)delay(10);cfg=settingsStore.read();if(cfg.magic!=MAGIC)defaults();randomSeed(micros());ready=modem.begin(EU868);Serial.println(ready?F("Modem έτοιμο"):F("Αποτυχία modem"));show();}
void loop(){while(Serial.available()){char c=Serial.read();if(c=='\n'){line.trim();command(line);line="";}else if(c!='\r'&&line.length()<100)line+=c;}if(!menu&&joined&&(!sent||millis()-lastTx>=cfg.interval*1000UL))publish();delay(10);}
